# Configuration du modèle de langage pour Sàmm
# Fournisseur LLM : "groq" ou "cerebras"
LLM_PROVIDER=groq

# Modèle utilisé (valeur par défaut recommandée : openai/gpt-oss-120b)
LLM_MODEL=openai/gpt-oss-120b

# URL de base optionnelle (si non renseignée, les URL officielles Groq ou Cerebras sont utilisées)
# Groq: https://api.groq.com/openai/v1 | Cerebras: https://api.cerebras.ai/v1
LLM_BASE_URL=

# Clés d'API (laisser vide, ne jamais commiter de vraies clés)
GROQ_API_KEY=
CEREBRAS_API_KEY=

# Cache disque pour l'évaluation (activer uniquement pour l'évaluation locale)
ENABLE_DISK_CACHE=false
